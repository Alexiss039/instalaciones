# Copiar este archivo como backend/.env y ajustar los valores.
# NO subir el archivo .env real al repositorio.

# Clave para firmar los tokens JWT (cadena larga y aleatoria).
# Si se deja vacía, se genera una al arrancar (los tokens se invalidan al reiniciar).
SECRET_KEY=

# Minutos de vigencia del token de acceso = 8 horas
TOKEN_MINUTOS=480

# Base de datos (por defecto SQLite local en backend/instalaciones.db)
# DATABASE_URL=sqlite:///./instalaciones.db

# Carpeta donde se guardan las fotografías de los reportes
CARPETA_SUBIDAS=uploads

# Tamaño máximo de cada fotografía en MB
FOTO_MAX_MB=5
